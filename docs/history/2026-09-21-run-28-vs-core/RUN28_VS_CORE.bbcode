[tr][td]500,000[/td][td]3:36:20[/td][td]3:54:13[/td][td]0:17:53[/td][td]7.6%[/td][td]2:04:44[/td][td]2:10:38[/td][/tr]
[tr][td]600,000[/td][td]5:54:41[/td][td]6:20:15[/td][td]0:25:34[/td][td]6.7%[/td][td]2:18:21[/td][td]2:26:02[/td][/tr]
[tr][td]700,000[/td][td]8:44:09[/td][td]9:19:15[/td][td]0:35:06[/td][td]6.3%[/td][td]2:49:28[/td][td]2:59:00[/td][/tr]
